{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "UseInMemoryDatabase": true,
  "Email": {
    "Provider": "Log"
  },
  "Media": {
    "Provider": "InMemory"
  },
  "Moderation": {
    "Provider": "InMemory"
  },
  "GenAi": {
    "Provider": "InMemory"
  },
  "Firebase": {
    "Provider": "InMemory"
  },
  "RateLimiting": {
    "Global": {
      "UserPermitLimit": 100000,
      "AnonymousPermitLimit": 100000
    }
  }
}
