{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseInMemoryDatabase": false,
  "ConnectionStrings": {
    "Mongo": ""
  },
  "Mongo": {
    "DatabaseName": "musubi"
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760,
      "KeepAliveTimeout": "00:02:00"
    }
  },
  "Jwt": {
    "Issuer": "musubi-api",
    "Audience": "musubi-app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 60
  },
  "Email": {
    "Provider": "Ses",
    "From": "",
    "Region": "us-east-1"
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
