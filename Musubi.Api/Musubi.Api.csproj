<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Musubi.Api</RootNamespace>
    <!-- Matriz de versionamiento: docs/versionado.md (unica fuente de la version de la API). -->
    <Version>0.3.0-alpha.2</Version>
    <UserSecretsId>musubi-api-dev</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CA1515: MVC solo descubre controllers publicos y System.Text.Json serializa los DTOs publicos. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageReference Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.6" />
    <PackageReference Include="AWSSDK.SimpleEmailV2" Version="4.0.106.6" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.2" />
    <!-- Fotos de HU-06: decodificar, enderezar, reducir y volver a codificar a WebP sin metadatos (MIT; excepcion 00-01). -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTest" />
    <InternalsVisibleTo Include="IntegrationTest" />
    <InternalsVisibleTo Include="SecurityTest" />
    <InternalsVisibleTo Include="ContractTest" />
    <InternalsVisibleTo Include="DatabaseTest" />
  </ItemGroup>

</Project>
