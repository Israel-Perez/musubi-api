{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseInMemoryDatabase": true,
  "ConnectionStrings": {
    "Mongo": "mongodb://localhost:27017"
  },
  "Mongo": {
    "DatabaseName": "musubi"
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760,
      "KeepAliveTimeout": "00:02:00"
    }
  },
  "Jwt": {
    "Issuer": "musubi-api",
    "Audience": "musubi-app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 60
  },
  "Email": {
    "Provider": "Log",
    "From": "Musubi <no-reply@musubi.example>",
    "Region": "us-east-1"
  },
  "Media": {
    "Provider": "InMemory",
    "Bucket": "",
    "Region": "us-east-1"
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Legal": {
    "TermsVersion": "2026-10",
    "PrivacyVersion": "2026-10"
  },
  "Cors": {
    "AllowedOrigins": [ "https://admin.musubi.example" ]
  }
}
