{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseInMemoryDatabase": true,
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=musubi;Username=musubi"
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760,
      "KeepAliveTimeout": "00:02:00"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "https://admin.musubi.example" ]
  }
}
