<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!--
    Package Source Mapping (anti dependency-confusion): cada paquete, incluidos los transitivos,
    debe coincidir con un patron. Al agregar un paquete nuevo, verificar con cache vacia (00-04, regla 4):
    dotnet restore Musubi.slnx -force -no-cache /p:RestorePackagesPath=<carpeta-vacia>
  -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="Asp.Versioning.*" />
      <package pattern="coverlet.*" />
      <package pattern="Microsoft.*" />
      <package pattern="Npgsql" />
      <package pattern="Npgsql.*" />
      <package pattern="Scalar.*" />
      <package pattern="SonarAnalyzer.*" />
      <package pattern="System.*" />
      <package pattern="xunit.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
